    }
  }
}

### q31-unites-fonctionnelles — Référentiel des UF avec occupation et patients présents
GRAPHQL http://localhost:8080/graphql

query UnitesFonctionnelles {
  unitesFonctionnelles {
    code
    libelle
    service
    capacite
    tauxOccupation
    sejoursEnCours {
