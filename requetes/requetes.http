### m08-muter-patient — Mutation vers une autre UF
GRAPHQL http://localhost:8080/graphql

mutation Muter($entree: MutationPatientInput!) {
  muterPatient(entree: $entree) {
    __typename
    ... on Sejour {
      numeroSejour
      ufCourante {
        code
        libelle
      }
      mouvements {
        type
        dateMouvement
        uniteFonctionnelle {
          code
        }
      }
    }
    ...Erreur
  }
}

fragment Erreur on ErreurMetier {
  code
  message
  details {
    champ
    message
  }
}

