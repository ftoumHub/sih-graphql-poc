}

### q23-parcours-mouvements — Parcours du patient dans l'hôpital (urgences -> USIC -> cardio)
GRAPHQL http://localhost:8080/graphql

query Parcours {
  sejour(id: 1) {
    numeroSejour
    mouvements {
      type
      dateMouvement
      uniteFonctionnelle {
        code
        libelle
        service
      }
    }
  }
}

### q24-n-plus-1-vs-batch — N+1 (sejourEnCours) contre batch loading (sejours) : comparer les logs SQL
GRAPHQL http://localhost:8080/graphql

query NPlusUn {
  patients(taille: 12) {
    contenu {
      nomAffiche
      sejourEnCours {
        numeroSejour
      }
      sejours {
        numeroSejour
      }
    }
  }
}

### q25-argument-de-champ — Argument sur un champ imbriqué + alias
GRAPHQL http://localhost:8080/graphql

query DocumentsDuPatient {
  patient(id: 1) {
    lettres: documents(type: LETTRE_DE_LIAISON) {
      titre
      statut
    }
    tous: documents {
      type
      titre
    }
  }
}

### q26-contenu-tronque — Argument de champ calculé : contenu tronqué
GRAPHQL http://localhost:8080/graphql

query Apercu {
  document(id: 1) {
    titre
    taille
    apercu: contenu(longueurMax: 30)
    complet: contenu
  }
}

### q27-sejours-en-cours — Séjours en cours avec UF et patient (batch loading)
GRAPHQL http://localhost:8080/graphql

query SejoursEnCours {
  sejours(filtre: { statuts: [EN_COURS] }, taille: 50) {
    infoPage { totalElements }
    contenu {
      numeroSejour
      type
      dateEntree
      dureeJours
      ufCourante {
        code
        libelle
      }
      patient {
        nomAffiche
        prenom
      }
    }
  }
}

