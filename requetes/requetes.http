      }
    }
  }
}

### q32-uf-par-code — Une UF par code
GRAPHQL http://localhost:8080/graphql

query Uf {
  uniteFonctionnelle(code: "4101") {
    libelle
    capacite
    tauxOccupation
    sejoursEnCours {
      numeroSejour
      motif
      dureeJours
    }
  }
}

### q33-recherche-interface — Recherche transverse : interface Noeud + fragments inline
GRAPHQL http://localhost:8080/graphql

query Recherche($texte: String!) {
  recherche(texte: $texte, limiteParType: 10) {
    __typename
    id
    ... on Patient {
      nomAffiche
      prenom
    }
    ... on Sejour {
      numeroSejour
      motif
    }
    ... on Document {
      type
      titre
    }
  }
}

{
  "texte": "cardi"
}

### q34-recherche-ipp — Recherche par IPP (seuls les patients ont des champs demandés)
GRAPHQL http://localhost:8080/graphql

query RechercheIpp {
  recherche(texte: "00010008") {
    __typename
    ... on Patient {
      nomAffiche
      ipp
    }
  }
}

### q35-statistiques — Tableau de bord : toutes les statistiques
GRAPHQL http://localhost:8080/graphql

query Statistiques {
  statistiques {
    nombrePatients
    nombreSejoursEnCours
    dureeMoyenneSejoursClosJours
    occupationParUf {
      ufCode
      libelle
      capacite
      patientsPresents
      tauxOccupation
    }
    documentsParTypeEtStatut {
      type
      statut
      nombre
    }
  }
}

### q36-statistiques-partielles — Un seul indicateur : une seule requête SQL exécutée
GRAPHQL http://localhost:8080/graphql

query UnIndicateur {
  statistiques {
    nombrePatients
  }
}

### q37-multi-racines — Plusieurs racines dans une même requête (écran d'accueil)
GRAPHQL http://localhost:8080/graphql

query EcranAccueil {
  statistiques {
    nombreSejoursEnCours
  }
  brouillons: documents(filtre: { statut: BROUILLON }, taille: 3) {
    infoPage { totalElements }
    contenu {
      titre
    }
  }
  urgences: uniteFonctionnelle(code: "3001") {
    sejoursEnCours {
      numeroSejour
      motif
    }
  }
}

