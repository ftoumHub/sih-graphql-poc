mutation DateAnterieure($sejourId: ID!) {
  muterPatient(entree: { sejourId: $sejourId, ufDestination: "1202", dateMutation: "2000-01-01T00:00:00" }) {
    __typename
    ...Erreur
  }
}

fragment Erreur on ErreurMetier {
  code
  message
  details {
    champ
    message
  }
}

{
  "sejourId": 2
