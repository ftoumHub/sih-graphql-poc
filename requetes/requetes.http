}

### e04-scalaire-invalide — Erreur de scalaire : date au mauvais format
GRAPHQL http://localhost:8080/graphql

query ScalaireInvalide {
  patients(filtre: { neApres: "12/03/1948" }) {
    infoPage { totalElements }
  }
}

### e05-profondeur-excessive — Requête trop profonde (25 niveaux > 20) : rejetée par MaxQueryDepthInstrumentation
GRAPHQL http://localhost:8080/graphql

query TropProfond {
  patient(id: 1) {
    sejours {
      patient {
        sejours {
          patient {
            sejours {
              patient {
                sejours {
                  patient {
                    sejours {
                      patient {
                        sejours {
                          patient {
                            sejours {
                              patient {
                                sejours {
                                  patient {
                                    sejours {
                                      patient {
                                        sejours {
                                          patient {
                                            sejours {
                                              patient {
                                                sejours {
                                                  numeroSejour
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

### e07-cout-excessif — Requête trop coûteuse (directive @cout) : rejetée avant exécution
GRAPHQL http://localhost:8080/graphql

query TropCouteuse {
  patients(taille: 100) {
    contenu {
      nomAffiche
      sejours {
        numeroSejour
