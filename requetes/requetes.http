### m21-erreur-sans-fragment — Sans fragment sur ErreurMetier, une erreur métier donne un objet vide : toujours la sélectionner !
GRAPHQL http://localhost:8080/graphql

mutation ErreurIgnoree {
  sortirPatient(entree: { sejourId: 1, modeSortie: DOMICILE }) {
    ... on Sejour {
      statut
    }
  }
}

### s01-tous-evenements — Subscription : tous les événements (interface + fragments inline)
GRAPHQL ws://localhost:8080/graphql-ws

subscription TousLesEvenements {
  evenements {
    __typename
    type
    horodatage
    ... on EvenementSejour {
      sejour {
        id
        numeroSejour
        statut
      }
    }
    ... on EvenementDocument {
      document {
        id
        titre
        statut
      }
    }
  }
}

### s02-evenements-patient — Subscription filtrée sur un patient et des types d'événements
GRAPHQL ws://localhost:8080/graphql-ws

subscription EvenementsPatient($patientId: ID!, $types: [TypeEvenement!]) {
  evenements(patientId: $patientId, types: $types) {
    type
    horodatage
    ... on EvenementSejour {
      sejour {
        numeroSejour
        statut
      }
    }
  }
}

{
  "patientId": 13,
  "types": [
    "ADMISSION",
    "MUTATION",
    "SORTIE"
  ]
}
