### m01-creer-patient — Création d'un patient (union ResultatPatient)
GRAPHQL http://localhost:8080/graphql

mutation CreerPatient($entree: CreerPatientInput!) {
  creerPatient(entree: $entree) {
    __typename
    ... on Patient {
      id
      ipp
      nomNaissance
      nomAffiche
      prenom
      age
      dateCreation
    }
    ...Erreur
  }
}

fragment Erreur on ErreurMetier {
  code
  message
  details {
    champ
    message
  }
}

{
  "entree": {
    "ipp": "00020001",
    "nomNaissance": "Durand",
    "prenom": "Alice",
    "dateNaissance": "1980-04-15",
    "sexe": "F",
    "telephone": "0611223344"
  }
}

### m02-creer-patient-invalide — Bean Validation : ErreurMetier VALIDATION avec un détail par champ
GRAPHQL http://localhost:8080/graphql

mutation CreerPatientInvalide {
  creerPatient(entree: {
    ipp: "00029999"
    nomNaissance: "   "
    prenom: ""
    dateNaissance: "2099-01-01"
    sexe: M
  }) {
    __typename
    ...Erreur
  }
}

fragment Erreur on ErreurMetier {
  code
  message
  details {
    champ
    message
  }
}

