      }
    }
  }
}

### q30-documents-multi-criteres — Filtre sur une liste d'énumérations + auteur
GRAPHQL http://localhost:8080/graphql

query DocumentsMultiCriteres {
  documents(filtre: { types: [LETTRE_DE_LIAISON, ORDONNANCE], auteur: "durand" }) {
    infoPage { totalElements }
    contenu {
      type
      titre
      auteur
