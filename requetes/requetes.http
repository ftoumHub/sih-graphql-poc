### m13-sortir-patient — Sortie du patient (date explicite facultative)
GRAPHQL http://localhost:8080/graphql

mutation Sortir($entree: SortieInput!) {
  sortirPatient(entree: $entree) {
    __typename
    ... on Sejour {
      numeroSejour
      statut
      dateSortie
      modeSortie
      dureeJours
      mouvements {
        type
      }
    }
    ...Erreur
  }
}

fragment Erreur on ErreurMetier {
  code
  message
  details {
    champ
    message
  }
}

{
  "entree": {
    "sejourId": 15,
    "modeSortie": "DOMICILE"
  }
}

### m14-sortir-sejour-clos — Règle métier : sortie d'un séjour déjà clos
