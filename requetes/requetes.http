# Catalogue des requêtes GraphQL du POC SIH
# Client HTTP IntelliJ IDEA : cliquer sur ▶ à gauche de chaque requête.
# Les ids des mutations (13, 15, 24...) supposent une base fraîche et le scénario joué dans l'ordre.

### q01-patient-par-id — Un patient par id, avec variable
GRAPHQL http://localhost:8080/graphql

query PatientParId($id: ID!) {
  patient(id: $id) {
    id
    ipp
    nomNaissance
    prenom
    dateNaissance
    age
    sexe
  }
}

{
  "id": 1
}

### q02-patient-inexistant — Patient inexistant : null, pas d'erreur
GRAPHQL http://localhost:8080/graphql

query PatientInexistant {
  patient(id: 9999) {
    id
  }
}

### q03-patient-par-ipp — Recherche par IPP (argument littéral) et champ calculé nomAffiche
GRAPHQL http://localhost:8080/graphql

query PatientParIpp {
  patientParIpp(ipp: "00010003") {
    nomNaissance
    nomUsage
    nomAffiche
    prenom
  }
}

### q04-syntaxe-raccourcie — Syntaxe raccourcie : query anonyme, un seul champ
GRAPHQL http://localhost:8080/graphql

{
  patient(id: 1) {
    prenom
  }
}

### q05-alias — Alias : deux fois le même champ avec des arguments différents
GRAPHQL http://localhost:8080/graphql

query DeuxPatients {
  jeanne: patient(id: 1) {
    prenom
    age
  }
  louis: patient(id: 2) {
    prenom
    age
  }
}

### q06-fragments — Fragments : factoriser une sélection de champs
GRAPHQL http://localhost:8080/graphql

query AvecFragments {
  premier: patient(id: 1) {
    ...IdentitePatient
  }
  second: patientParIpp(ipp: "00010004") {
    ...IdentitePatient
    estMineur
  }
}

fragment IdentitePatient on Patient {
  id
  ipp
  nomAffiche
  prenom
  dateNaissance
  age
  sexe
}

### q07-valeur-par-defaut-variable — Variable avec valeur par défaut
GRAPHQL http://localhost:8080/graphql

query PremiersPatients($taille: Int = 3) {
  patients(taille: $taille) {
    contenu {
      nomAffiche
      prenom
    }
    infoPage {
      taille
    }
  }
}

### q08-pagination — Pagination : page 1, 5 éléments par page
GRAPHQL http://localhost:8080/graphql

query Pagination($page: Int!, $taille: Int!) {
  patients(page: $page, taille: $taille) {
    infoPage {
      page
      taille
      totalElements
      totalPages
      estDernierePage
    }
    contenu {
      id
      nomAffiche
      prenom
    }
  }
}

{
  "page": 1,
  "taille": 5
}

### q09-filtre-nom — Filtre sur le nom (naissance OU usage), insensible à la casse
GRAPHQL http://localhost:8080/graphql

query FiltreNom {
  patients(filtre: { nom: "mar" }) {
    infoPage { totalElements }
    contenu {
      nomNaissance
      nomUsage
      prenom
    }
  }
}

### q10-filtre-combine — Filtre combiné passé en variable (input object)
GRAPHQL http://localhost:8080/graphql

query FiltreCombine($filtre: FiltrePatient) {
  patients(filtre: $filtre) {
    infoPage { totalElements }
    contenu {
      nomAffiche
      prenom
      dateNaissance
      sexe
    }
  }
}

{
  "filtre": {
    "sexe": "F",
    "neAvant": "1970-01-01"
  }
}

### q11-patients-mineurs — Patients mineurs (scalaire Date en entrée)
GRAPHQL http://localhost:8080/graphql

query Mineurs($neApres: Date!) {
  patients(filtre: { neApres: $neApres }) {
    contenu {
      nomAffiche
      prenom
      age
      estMineur
    }
  }
}

{
  "neApres": "2008-11-19"
}

### q12-directives — Directives @include / @skip pilotées par variables
GRAPHQL http://localhost:8080/graphql

query Directives($avecSejours: Boolean!, $sansTelephone: Boolean!) {
  patient(id: 1) {
    prenom
    telephone @skip(if: $sansTelephone)
    sejours @include(if: $avecSejours) {
      numeroSejour
      statut
    }
  }
}

{
  "avecSejours": true,
  "sansTelephone": true
}

### q13-typename — Méta-champ __typename
GRAPHQL http://localhost:8080/graphql

query TypeName {
  patient(id: 1) {
    __typename
    id
    sejours {
      __typename
      numeroSejour
    }
  }
}

### q14-introspection-type — Introspection : structure du type Sejour
GRAPHQL http://localhost:8080/graphql

query IntrospectionSejour {
  __type(name: "Sejour") {
    name
    description
    fields {
      name
      description
      type {
        kind
        name
        ofType {
          kind
          name
        }
      }
    }
  }
}

### q15-introspection-enum — Introspection : valeurs d'une énumération
GRAPHQL http://localhost:8080/graphql

query IntrospectionEnum {
  __type(name: "TypeDocument") {
    enumValues {
      name
    }
  }
}

### q16-introspection-racines — Introspection : toutes les opérations disponibles
GRAPHQL http://localhost:8080/graphql

query OperationsDisponibles {
  __schema {
    queryType { fields { name } }
    mutationType { fields { name } }
    subscriptionType { fields { name } }
  }
}

### q17-champs-deprecies — Introspection : champs dépréciés et raison de la dépréciation
GRAPHQL http://localhost:8080/graphql

query ChampsDeprecies {
  __type(name: "Mouvement") {
    fields(includeDeprecated: true) {
      name
      isDeprecated
      deprecationReason
    }
  }
}

### q20-dossier-patient — Dossier patient complet : séjours, mouvements, documents
GRAPHQL http://localhost:8080/graphql

query DossierPatient($id: ID!) {
  patient(id: $id) {
    nomAffiche
    prenom
    age
    sejours {
      numeroSejour
      type
      statut
      motif
      dateEntree
      dateSortie
      dureeJours
      ufCourante {
        code
        libelle
      }
      mouvements {
        type
        dateMouvement
        uniteFonctionnelle {
          libelle
        }
      }
      documents {
        id
        type
        titre
        statut
      }
    }
  }
}

{
  "id": 1
}

### q21-sejour-vers-patient — Navigation inverse : du séjour vers le patient
GRAPHQL http://localhost:8080/graphql

query SejourEtPatient {
  sejour(id: 3) {
    numeroSejour
    motif
    estEnCours
    patient {
      nomAffiche
      prenom
      age
    }
    ufCourante {
      code
      libelle
      service
    }
  }
}

### q22-sejour-par-numero — Séjour par numéro (NDA)
GRAPHQL http://localhost:8080/graphql

query SejourParNumero($numero: String!) {
  sejourParNumero(numero: $numero) {
    id
